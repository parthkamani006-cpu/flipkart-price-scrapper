{
  "name": "flipkart-seller-price-scraper",
  "version": "1.0.0",
  "private": true,
  "description": "Flipkart seller price comparison — Playwright scraper plus a Next.js control dashboard.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:scraper": "tsc -p tsconfig.scraper.json --noEmit",
    "typecheck:worker": "tsc -p tsconfig.worker.json --noEmit",
    "worker": "ts-node -T -r tsconfig-paths/register --project tsconfig.worker.json worker/index.ts",
    "scrape": "ts-node --project tsconfig.scraper.json scraper/index.ts",
    "verify": "ts-node -T --project tsconfig.scraper.json scraper/verify.ts",
    "build:scraper": "tsc -p tsconfig.scraper.json",
    "test:store": "ts-node -T -r tsconfig-paths/register --project tsconfig.test.json scripts/store.test.ts",
    "test:recommendation": "ts-node -T -r tsconfig-paths/register --project tsconfig.test.json scripts/recommendation.test.ts",
    "test:width": "ts-node -T -r tsconfig-paths/register --project tsconfig.test.json scripts/poolWidth.test.ts",
    "test:limiter": "ts-node -T -r tsconfig-paths/register --project tsconfig.test.json scripts/rateLimiter.test.ts",
    "test:ip": "ts-node -T -r tsconfig-paths/register --project tsconfig.test.json scripts/ipAllowlist.test.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@radix-ui/react-checkbox": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-popover": "^1.1.4",
    "@radix-ui/react-progress": "^1.1.1",
    "@radix-ui/react-scroll-area": "^1.2.2",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-switch": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-toast": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@supabase/supabase-js": "~2.74.0",
    "@tanstack/react-query": "^5.62.11",
    "@tanstack/react-virtual": "^3.11.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.469.0",
    "next": "^15.5.20",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-hook-form": "^7.54.2",
    "recharts": "^2.15.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "xlsx": "^0.18.5",
    "zod": "^3.24.1"
  },
  "overrides": {
    "postcss": "^8.5.10"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "dotenv": "^16.6.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.20",
    "playwright": "^1.49.0",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.17",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2"
  }
}
