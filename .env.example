# Copy to .env.local (Next.js) or .env (worker) and fill in.
# NEVER commit a filled-in copy — .gitignore blocks .env / .env.* for that reason.

# ─── Browser (safe to expose; these ship in the client bundle) ──────────────────
# Supabase → Project Settings → API → Project URL / anon public key.
# Used only to open the Realtime socket. RLS restricts it to SELECT.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...replace-me

# ─── Server only (Vercel env vars + GitHub Actions secrets) ────────────────────
# Supabase → Project Settings → API → service_role key. Bypasses RLS.
# Belongs in: Vercel project env (not "exposed to browser") and GitHub Actions
# secrets. Nowhere else. Never prefix it with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...replace-me

# ─── Vercel only: triggering the GitHub Actions worker ─────────────────────────
# Fine-grained personal access token scoped to THIS repository with
# "Contents: read" + "Actions: write". Used server-side for repository_dispatch.
GITHUB_DISPATCH_TOKEN=github_pat_...replace-me
GITHUB_REPO=your-github-user/flipkart-price-scrapper

# ─── GitHub Actions only: worker tuning ────────────────────────────────────────
# Ceiling on Playwright contexts regardless of what the job row asks for.
# An ubuntu-latest runner is 4 cores / 16 GB; ~10 contexts is ~2 GB of Chromium.
WORKER_MAX_CONCURRENCY=8

# Optional. Flipkart rate-limits by IP and GitHub's runners use Azure datacentre
# addresses. Leave unset to go out directly; set to route Playwright through a
# proxy if runs start coming back BLOCKED.
# PROXY_URL=http://proxy.example.com:8000
# PROXY_USERNAME=
# PROXY_PASSWORD=

# ─── Optional ──────────────────────────────────────────────────────────────────
# Timezone used for the per-hour analytics buckets. Must match the SQL default
# in supabase/migrations/0002_views.sql if you change it.
# ANALYTICS_TIMEZONE=Asia/Kolkata

# ─── Vercel only: IP allowlist (the dashboard's front door) ────────────────────
# The app has no login. Set this and only these addresses can reach it at all —
# pages, API routes and JS bundles alike. Leave it UNSET and the gate is open.
#
# IPv4 or IPv6, bare or CIDR, separated by commas/newlines, "#" for comments.
# A bare address is an exact match. Find your address at https://ifconfig.me
#
#   IP_ALLOWLIST="203.0.113.7, 198.51.100.0/24 # office, 2001:db8::/32"
#
# Note: env var changes only take effect on the NEXT deployment. If your ISP
# rotates your address and locks you out, edit this in the Vercel dashboard and
# redeploy — the dashboard itself is not behind the allowlist. Home broadband is
# usually dynamic, so prefer your ISP's /24 or a static-IP VPN over a bare host.
# IP_ALLOWLIST=
